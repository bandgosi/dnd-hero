# Пример настроек. Скопируйте в файл .env и измените при необходимости.
# Без .env приложение работает только на этом компьютере: http://localhost:3000

# Адрес и порт. 127.0.0.1 — доступ только с этого компьютера (по умолчанию).
HOST=127.0.0.1
PORT=3000

# Папка с базой данных, фотографиями, копиями и исходными файлами Excel.
# По умолчанию — family-archive/data
# DATA_DIR=/путь/к/папке/семейного-архива

# Пароль для входа. ОБЯЗАТЕЛЕН при доступе из сети (HOST не 127.0.0.1, TRUST_PROXY или ALLOWED_HOSTS).
# Лучше хранить не сам пароль, а его хэш: npm run hash-password
# APP_PASSWORD_HASH=scrypt:32768:8:1:...
# Или (менее безопасно) сам пароль, не короче 10 символов:
# APP_PASSWORD=придумайте-длинный-пароль

# Для размещения в интернете за HTTPS-прокси (nginx, Caddy) — проще всего deploy/install.sh:
# COOKIE_SECURE=1
# TRUST_PROXY=loopback
# ALLOWED_HOSTS=archive.example.ru

# Срок действия входа, дней
# SESSION_DAYS=30

# Фото уменьшаются в браузере до N пикселей по длинной стороне и сжимаются в JPEG (0 — хранить как есть)
# PHOTO_MAX_SIDE=2048
# PHOTO_QUALITY=0.85

# Ограничения размеров, МБ
# MAX_PHOTO_MB=15
# MAX_IMPORT_MB=10
# MAX_BACKUP_MB=2048

# Автоматическая резервная копия раз в N дней, только если были изменения (0 — выключить)
# AUTO_BACKUP_DAYS=1
# Сколько хранить автоматических копий и копий «перед изменениями»
# AUTO_BACKUP_KEEP=3
# SAFETY_BACKUP_KEEP=3

# Сколько места на диске всегда оставлять свободным, МБ
# DISK_RESERVE_MB=300
